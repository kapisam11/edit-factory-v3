# Backup and maintenance schedule examples for the single-host deployment

# Daily: full SQLite + knowledge + published output backup. Use an encrypted
# rclone crypt remote for off-host storage; production must not rely on local-only backups.
0 2 * * * cd /opt/edit-factory-v3 && AIVF_ENV=production AIVF_BACKUP_RCLONE_REMOTE=crypt:aivf-offsite bash 06-CONFIG-AND-DEPLOYMENT/backup_state.sh >> /var/log/aivf-backup.log 2>&1

# Hourly: SQLite backup plus operational retention cleanup and stale workspace cleanup.
5 * * * * cd /opt/edit-factory-v3 && AIVF_DB_BACKUP_RCLONE_REMOTE=crypt:aivf-db bash 06-CONFIG-AND-DEPLOYMENT/backup_db_hourly.sh >> /var/log/aivf-db-backup.log 2>&1
17 * * * * cd /opt/edit-factory-v3 && /usr/local/bin/aivf-maintenance /srv/aivf/state >> /var/log/aivf-maintenance.log 2>&1

# Weekly: run the restore drill against the most recent verified backup.
30 3 * * 0 cd /opt/edit-factory-v3 && bash 06-CONFIG-AND-DEPLOYMENT/restore_smoke.sh /srv/aivf/backups/latest.tar.gz >> /var/log/aivf-restore.log 2>&1