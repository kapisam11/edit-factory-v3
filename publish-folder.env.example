# Copy to publish-folder.env (the real file is Git-ignored) and fill in values.
# Use absolute Windows paths with forward slashes, e.g. C:/Users/you/Videos/publish-watch

AIVF_PUBLISH_WATCH_DIR=publish-watch
AIVF_STATE_DIR=state
AIVF_FILE_PUBLISH_DB=state/file-publishing.sqlite
AIVF_FILE_PUBLISH_PLATFORMS=youtube
AIVF_FILE_PUBLISH_TIME_UTC=12:00
AIVF_FILE_PUBLISH_POLL_SECONDS=30
AIVF_FILE_PUBLISH_STABLE_SECONDS=60
AIVF_FILE_PUBLISH_MAX_BYTES=1073741824
AIVF_FILE_PUBLISH_MAX_DURATION_SECONDS=900
AIVF_FILE_PUBLISH_MAX_PER_ACCOUNT_DAILY=1
AIVF_FILE_PUBLISH_MAX_ATTEMPTS=6
AIVF_FILE_PUBLISH_ALLOW_PUBLIC=0

# YouTube: authorize the intended channel once; keep tokens outside the repo.
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_PATH=
YOUTUBE_IDEMPOTENCY_DIR=

# Instagram Reels: professional account + app permissions and approved access token required.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v23.0

# TikTok: Content Posting API app access + video.publish scope are required.
TIKTOK_OPEN_ID=
TIKTOK_ACCESS_TOKEN=

# Optional webhook URL for terminal failures / ambiguous outcomes.
AIVF_FILE_PUBLISH_FAILURE_WEBHOOK_URL=
